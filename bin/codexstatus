#!/usr/bin/env python3
"""Development and user-install wrapper for the Codex Status provider."""

import os
import sys
from pathlib import Path


script = Path(__file__).resolve()
repo_source = script.parent.parent / "src"
data_home = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share"))
installed_source = data_home / "codexstatus" / "src"
configured_source = os.environ.get("CODEXSTATUS_SOURCE")
source = Path(configured_source) if configured_source else repo_source
if not (source / "codexstatus").is_dir():
    source = installed_source
sys.path.insert(0, str(source))

from codexstatus.cli import main  # noqa: E402

raise SystemExit(main())
